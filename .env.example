# Copiar a .env.local. Sólo nombres y valores locales de ejemplo; nunca credenciales reales en Git.

# URL base del backend Express (sin /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Firebase Authentication (SDK cliente). Vacías hasta DEC-02 y autorización de Paulo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
